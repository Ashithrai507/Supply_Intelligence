# Frontend (Vite) — Phase 1 relaunch, plain REST
# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth — set both to enable self sign-up / sign-in via Supabase.
# Leave empty to keep the demo (preset hospital) login flow.
# Project Settings → API: Project URL and anon/public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
